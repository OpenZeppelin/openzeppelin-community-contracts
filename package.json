{
  "name": "@openzeppelin/community-contracts",
  "version": "0.0.1",
  "description": "Solidity library of smart contracts from the OpenZeppelin Community",
  "author": "OpenZeppelin Community <maintainers@openzeppelin.org>",
  "license": "MIT",
  "files": [
    "/contracts/**/*.sol",
    "!/contracts/mocks/**/*"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "docs": "npm run prepare-docs && oz-docs",
    "docs:watch": "oz-docs watch contracts docs/templates docs/config.js",
    "prepare": "husky",
    "prepare-docs": "scripts/prepare-docs.sh",
    "lint": "npm run lint:js && npm run lint:sol",
    "lint:fix": "npm run lint:js:fix && npm run lint:sol:fix",
    "lint:js": "npm run prettier -- '**/*.{js,ts}' --check && eslint . --ignore-pattern lib/",
    "lint:js:fix": "npm run prettier -- '**/*.{js,ts}' --write && eslint . --fix --ignore-pattern lib/",
    "lint:sol": "npm run prettier -- '{contracts,test}/**/*.sol' --check && npm run solhint -- '{contracts,test}/**/*.sol'",
    "lint:sol:fix": "npm run prettier -- '{contracts,test}/**/*.sol' --write && npm run solhint -- '{contracts,test}/**/*.sol' --fix",
    "prettier": "prettier --log-level warn --ignore-path .gitignore --ignore-path .prettierignore",
    "solhint": "solhint --config solhint.config.cjs --noPoster --noPrompt --disc",
    "clean": "hardhat clean && rimraf build contracts/build",
    "generate": "scripts/generate/run.js",
    "test": "hardhat test",
    "test:generation": "scripts/checks/generation.sh",
    "test:inheritance": "scripts/checks/inheritance-ordering.js artifacts/build-info/*",
    "test:pragma": "scripts/checks/pragma-validity.js artifacts/build-info/*",
    "coverage": "hardhat test --coverage",
    "gas-report": "hardhat test --gas-stats"
  },
  "homepage": "https://openzeppelin.com/contracts/",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenZeppelin/openzeppelin-community-contracts.git"
  },
  "bugs": {
    "url": "https://github.com/OpenZeppelin/openzeppelin-community-contracts/issues"
  },
  "keywords": [
    "solidity",
    "ethereum",
    "smart",
    "contracts",
    "security",
    "zeppelin"
  ],
  "devDependencies": {
    "@openzeppelin/contracts": "file:lib/@openzeppelin-contracts",
    "husky": "^9.1.7"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "npm run prettier -- --check",
      "eslint"
    ],
    "{contracts,test}/**/*.sol": [
      "npm run prettier -- --check",
      "npm run solhint --"
    ]
  },
  "type": "module"
}
